// Independent persisted readback: every shard and all three control/metadata copies.
'use strict';
const fs=require('node:fs'),path=require('node:path');
const {sha,json,durable,regular:plainRead,verifyRoot,totalFiles,syncDir,cidDigest}=require('./custody_common.cljk');
function regular(file,max){const b=plainRead(file,max),fd=fs.openSync(file,'r');try{fs.fsyncSync(fd);}finally{fs.closeSync(fd);}return b;}
const [root,trustFile,out]=process.argv.slice(2);if(!root||!out||fs.existsSync(out))throw Error('new audit required');
const trust=JSON.parse(regular(trustFile)),rb=regular(path.join(root,'control/2/root.json')),body=verifyRoot(rb,trust),cat=regular(path.join(root,'control/2/catalog.jsonl'));if(sha(cat)!==body.catalogSHA)throw Error('catalog trust');
let readBytes=0,shards=0;const began=performance.now();
for(const i of [0,2,4]){const d=path.join(root,'control',String(i));if(fs.statSync(path.join(d,'data-key.bin')).mode&0o077)throw Error('key custody permissions');for(const [name,hash] of [['root.json',trust.rootSHA],['catalog.jsonl',body.catalogSHA],['index.jsonl',body.indexSHA],['inventory.jsonl',body.inventorySHA],['data-key.bin',body.keySHA],...Object.entries(body.assets)]){const b=regular(path.join(d,name));if(sha(b)!==hash)throw Error('persisted control differs: '+name);readBytes+=b.length;}syncDir(d);}
const packs=cat.toString().trimEnd().split('\n').map(JSON.parse);for(let pno=0;pno<packs.length;pno++){const p=packs[pno],dir=path.join(root,'packs',p.id),mb=regular(path.join(dir,'manifest-2.json')),m=JSON.parse(mb);if(sha(mb)!==p.manifestSHA)throw Error('manifest trust');for(const i of [0,2,4]){const b=regular(path.join(dir,`manifest-${i}.json`)),r=regular(path.join(dir,`receipt-${i}.json`));if(sha(b)!==p.manifestSHA||r.toString()!==json({'manifest-sha256':p.manifestSHA,'payload-sha256':m.sha256}).toString())throw Error('metadata readback differs');readBytes+=b.length+r.length;}
 for(let i=0;i<6;i++){const b=regular(path.join(dir,`shard-${i}.bin`),48*1024*1024);if(b.length!==m.width||sha(b)!==m.shards[i])throw Error('shard readback differs');readBytes+=b.length;shards++;}syncDir(dir);if(pno%250===249)console.log(JSON.stringify({stage:'audit',packs:pno+1,readBytes,wallSeconds:(performance.now()-began)/1000}));}
let archive=null;const rawFile=path.join(root,'restored-lake.bin');if(fs.existsSync(rawFile)){const st=fs.lstatSync(rawFile);if(!st.isFile()||st.size!==body.inventoryBytes)throw Error('raw archive size/type');const index=regular(path.join(root,'control/2/index.jsonl'));if(sha(index)!==body.indexSHA)throw Error('raw archive index trust');const fd=fs.openSync(rawFile,'r'),buffer=Buffer.alloc(4*1024*1024),all=require('crypto').createHash('sha256'),seen=new Set();let current=null,hash=null,offset=0,blockBytes=0,bytes=0;
 const finish=()=>{if(current===null)return;if(offset!==blockBytes||hash.digest('hex')!==cidDigest(current).toString('hex')||seen.has(current))throw Error('archive CID mismatch');seen.add(current);};
 try{for(const line of index.toString().trimEnd().split('\n')){const w=JSON.parse(line);if(w.bytes>buffer.length||w.bytes<1)throw Error('archive window bound');if(w.cid!==current){finish();current=w.cid;hash=require('crypto').createHash('sha256');offset=0;blockBytes=w.blockBytes;}if(w.offset!==offset)throw Error('archive gap');let at=0;while(at<w.bytes){const n=fs.readSync(fd,buffer,at,w.bytes-at,null);if(!n)throw Error('archive truncated');at+=n;}const b=buffer.subarray(0,w.bytes);if(sha(b)!==w.sha256)throw Error('archive window SHA');hash.update(b);all.update(b);offset+=b.length;bytes+=b.length;}finish();if(bytes!==body.inventoryBytes||seen.size!==body.inventoryRows)throw Error('archive full coverage');fs.fsyncSync(fd);archive={bytes,verifiedCIDs:seen.size,sha256:all.digest('hex'),trustedIndexSHA:body.indexSHA,independentReadback:true};}finally{fs.closeSync(fd);}}
syncDir(path.join(root,'packs'));syncDir(path.join(root,'control'));syncDir(root);
const controlAllocation=totalFiles(path.join(root,'control')),packAllocation=totalFiles(path.join(root,'packs')),custodyAllocation=Object.fromEntries(['files','bytes','allocatedBytes'].map(k=>[k,controlAllocation[k]+packAllocation[k]]));
const stat=fs.statfsSync(root),r={schema:'yataverse-persistent-readback/v1',rootSHA:trust.rootSHA,inventoryBytes:body.inventoryBytes,inventoryRows:body.inventoryRows,packs:packs.length,shards,allControlCopies:3,allMetadataCopies:3,readBytes,rawArchive:archive,wallMs:performance.now()-began,allocation:totalFiles(root),custodyAllocation,controlAllocation,filesystem:{capacityBytes:stat.blocks*stat.bsize,availableBytes:stat.bavail*stat.bsize},verified:true,coldProcess:true,fsync:true,limits:'filesystem readback, no power-cut or cache eviction; no service files changed'};durable(out,json(r));console.log(JSON.stringify(r));
