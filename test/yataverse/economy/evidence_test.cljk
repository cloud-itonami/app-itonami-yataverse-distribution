(ns yataverse.economy.evidence-test
  (:require [kotoba.test :refer [deftest is testing]]
            [yataverse.economy.evidence :as evidence]))

(def receipt
  {:schema "kotoba.service-evidence/v1"
   :event-id (str "sha256:" (apply str (repeat 64 "a")))
   :order-id "order-17"
   :provider-did "did:key:zProvider"
   :work-kind :yataverse-useful-egress
   :service-category :delivery-serving
   :policy-version "policy-4"
   :measure {:kind :client-useful-bytes :value "65536"}
   :evidence-cids ["bafyEvidenceCID"]
   :signatures {:provider {:did "did:key:zProvider" :signature "provider-sig"}
                :witnesses [{:did "did:key:zWitness" :signature "witness-sig"}]}
   :nonce "request-17-attempt-1"})

(def passing-verifiers
  {:digest-valid? (fn [_ _] true)
   :signature-valid? (fn [_ _] true)
   :policy-valid? (fn [_] true)
   :evidence-valid? (fn [_] true)})

(deftest schema-is-domain-separated-and-economic-neutral-test
  (testing "work kinds bind one category and one useful-work measure"
    (is (= {:category :delivery-serving :measure-kind :client-useful-bytes}
           (get evidence/work-contracts :yataverse-useful-egress)))
    (is (empty? (evidence/shape-errors receipt))))
  (testing "digest and signatures use stable, non-circular payloads"
    (is (= (dissoc receipt :event-id :signatures)
           (evidence/canonical-body receipt)))
    (is (= (str "kotoba.service-evidence/v1\n" (:event-id receipt))
           (evidence/signing-message receipt))))
  (testing "the admitted receipt cannot encode a token action or private payload"
    (is (some #{:economic-action-field-forbidden}
              (evidence/shape-errors (assoc receipt :token :YATA))))
    (is (some #{:private-payload-field-forbidden}
              (evidence/shape-errors (assoc receipt :prompt "private")))))
  (testing "non-map input returns a shape error"
    (is (some #{:receipt-must-be-map} (evidence/shape-errors "not a map"))))
  (testing "a category or measurement from another service kind is rejected"
    (is (some #{:work-category-mismatch}
              (evidence/shape-errors (assoc receipt :service-category :placement-repair))))
    (is (some #{:invalid-measure}
              (evidence/shape-errors
               (assoc receipt :measure {:kind :verified-repair-bytes :value "1"}))))))

(deftest admission-requires-independent-verification-test
  (testing "all required verifiers must be present and pass"
    (is (thrown-with-msg? #?(:clj Exception :cljs js/Error)
                          #"verifiers are required"
                          (evidence/verify-receipt receipt {})))
    (is (thrown-with-msg? #?(:clj Exception :cljs js/Error)
                          #"digest did not verify"
                          (evidence/verify-receipt
                           receipt (assoc passing-verifiers
                                          :digest-valid? (fn [_ _] false)))))
    (is (thrown-with-msg? #?(:clj Exception :cljs js/Error)
                          #"signature did not verify"
                          (evidence/verify-receipt
                           receipt (assoc passing-verifiers
                                          :signature-valid? (fn [_ signer]
                                                              (= "did:key:zProvider"
                                                                 (:did signer)))))))
    (is (thrown-with-msg? #?(:clj Exception :cljs js/Error)
                          #"reference did not verify"
                          (evidence/verify-receipt
                           receipt (assoc passing-verifiers
                                          :evidence-valid? (fn [_] false)))))
    (is (thrown-with-msg? #?(:clj Exception :cljs js/Error)
                          #"policy is not active"
                          (evidence/verify-receipt
                           receipt (assoc passing-verifiers
                                          :policy-valid? (fn [_] false))))))
  (testing "verification returns evidence but never a payment action"
    (let [result (evidence/admit-receipt (evidence/empty-ledger)
                                         receipt passing-verifiers)]
      (is (= :accepted (:status result)))
      (is (= [] (:economic-actions result)))
      (is (= 1 (count (get-in result [:ledger :events])))))))

(deftest replay-guard-test
  (testing "replaying the same event body is idempotent"
    (let [first-result (evidence/admit-receipt (evidence/empty-ledger)
                                               receipt passing-verifiers)
          duplicate (evidence/admit-receipt (:ledger first-result)
                                            receipt passing-verifiers)]
      (is (= :duplicate (:status duplicate)))
      (is (= (:ledger first-result) (:ledger duplicate)))))
  (testing "changed content cannot reuse an event ID"
    (let [first-result (evidence/admit-receipt (evidence/empty-ledger)
                                               receipt passing-verifiers)
          changed (assoc-in receipt [:measure :value] "131072")]
      (is (thrown-with-msg? #?(:clj Exception :cljs js/Error)
                            #"event-id collision"
                            (evidence/admit-receipt (:ledger first-result)
                                                    changed passing-verifiers)))))
  (testing "an order-scoped nonce cannot back a second event ID"
    (let [first-result (evidence/admit-receipt (evidence/empty-ledger)
                                               receipt passing-verifiers)
          changed (assoc receipt :event-id
                         (str "sha256:" (apply str (repeat 64 "b"))))]
      (is (thrown-with-msg? #?(:clj Exception :cljs js/Error)
                            #"nonce already used"
                            (evidence/admit-receipt (:ledger first-result)
                                                    changed passing-verifiers))))))
