(ns yataverse.economy.evidence
  "Economic-neutral, verifiable service receipts for distributed work.

  This namespace admits evidence only. It does not mint, price, reserve,
  convert, transfer, or pay EN, KUMO, Murakumo credits, YATA, or USDC. Each
  economic domain must make its own separately authorized decision."
  (:require [kotoba.lang.text :as str]))

(def schema "kotoba.service-evidence/v1")

(def work-contracts
  {:itonami-compute {:category :compute-execution
                     :measure-kind :verified-output-tokens}
   :yataverse-useful-egress {:category :delivery-serving
                             :measure-kind :client-useful-bytes}
   :kura-retention {:category :storage-retention
                    :measure-kind :verified-byte-seconds}
   :kura-repair {:category :placement-repair
                 :measure-kind :verified-repair-bytes}})

(defn canonical-body
  "Fields covered by the event digest, before JCS serialization. Signatures and
  the event ID itself are excluded to avoid a digest cycle."
  [receipt]
  (dissoc receipt :event-id :signatures))

(defn signing-message
  "Exact UTF-8 message provider and witness keys sign after event digesting."
  [{:keys [event-id]}]
  (str schema "\n" event-id))

(def ^:private receipt-keys
  #{:schema :event-id :order-id :provider-did :work-kind :service-category
    :policy-version :measure :evidence-cids :signatures :nonce})

(def ^:private economic-keys
  #{:token :token-symbol :amount :currency :chain :epoch :root :payee
    :recipient :payout :settlement :conversion :exchange-rate})

(def ^:private private-payload-keys
  #{:prompt :customer-payload :request-body :personal-data})

(defn- nonblank-string? [value]
  (and (string? value) (not (str/blank? value))))

(defn- positive-decimal-string? [value]
  (and (string? value)
       (re-matches #"(?:0|[1-9][0-9]*)" value)
       (some #(not= % \0) value)))

(defn- all-map-keys [value]
  (cond
    (map? value) (concat (keys value) (mapcat all-map-keys (vals value)))
    (coll? value) (mapcat all-map-keys value)
    :else []))

(defn shape-errors
  "Return structural errors without claiming any signature/CID was verified.

  Work kind fixes the service category and measurement unit. The strict field
  sets keep raw prompts, customer bytes, payment instructions, and token-domain
  fields out of this shared receipt."
  [{:keys [schema event-id order-id provider-did work-kind service-category
           policy-version measure evidence-cids signatures nonce]
    :as receipt}]
  (let [receipt-map? (map? receipt)
        contract (get work-contracts work-kind)
        provider-signature (:provider signatures)
        witnesses (:witnesses signatures)]
    (cond-> []
      (not= schema yataverse.economy.evidence/schema)
      (conj :unsupported-schema)

      (not (map? receipt))
      (conj :receipt-must-be-map)

      (seq (remove receipt-keys (keys (if receipt-map? receipt {}))))
      (conj :unsupported-receipt-field)

      (not (and (string? event-id)
                (re-matches #"sha256:[0-9a-f]{64}" event-id)))
      (conj :invalid-event-id)

      (not (nonblank-string? order-id))
      (conj :invalid-order-id)

      (not (and (string? provider-did)
                (str/starts-with? provider-did "did:key:")))
      (conj :invalid-provider-did)

      (nil? contract)
      (conj :unsupported-work-kind)

      (and contract (not= service-category (:category contract)))
      (conj :work-category-mismatch)

      (not (nonblank-string? policy-version))
      (conj :invalid-policy-version)

      (not (and (map? measure)
                (= #{:kind :value} (set (keys measure)))
                contract
                (= (:kind measure) (:measure-kind contract))
                (positive-decimal-string? (:value measure))))
      (conj :invalid-measure)

      (not (and (vector? evidence-cids)
                (seq evidence-cids)
                (every? nonblank-string? evidence-cids)))
      (conj :invalid-evidence-cids)

      (not (nonblank-string? nonce))
      (conj :invalid-nonce)

      (not (map? signatures))
      (conj :missing-signatures)

      (and (map? signatures)
           (seq (remove #{:provider :witnesses} (keys signatures))))
      (conj :unsupported-signature-field)

      (not (and (map? provider-signature)
                (= #{:did :signature} (set (keys provider-signature)))
                (= provider-did (:did provider-signature))
                (nonblank-string? (:signature provider-signature))))
      (conj :invalid-provider-signature-shape)

      (not (and (vector? witnesses)
                (seq witnesses)
                (every? (fn [{:keys [did signature] :as witness}]
                          (and (map? witness)
                               (= #{:did :signature} (set (keys witness)))
                               (nonblank-string? did)
                               (str/starts-with? did "did:key:")
                               (not= did provider-did)
                               (nonblank-string? signature)))
                        witnesses)
                (= (count witnesses)
                   (count (distinct (map :did witnesses))))))
      (conj :invalid-independent-witnesses)

      (some economic-keys (all-map-keys receipt))
      (conj :economic-action-field-forbidden)

      (some private-payload-keys (all-map-keys receipt))
      (conj :private-payload-field-forbidden))))

(defn verify-receipt
  "Fail closed unless structure, content digest, every signature, and evidence
  references are verified by injected production-capable adapters. Returns the
  receipt unchanged; no economic action is produced."
  [receipt {:keys [digest-valid? signature-valid? evidence-valid? policy-valid?]}]
  (let [errors (shape-errors receipt)]
    (when (seq errors)
      (throw (ex-info "service evidence has invalid shape" {:errors errors})))
    (when-not (and (fn? digest-valid?)
                   (fn? signature-valid?)
                   (fn? evidence-valid?)
                   (fn? policy-valid?))
      (throw (ex-info "digest, signature, evidence, and policy verifiers are required" {})))
    (when-not (true? (digest-valid? (canonical-body receipt) (:event-id receipt)))
      (throw (ex-info "service evidence digest did not verify"
                      {:event-id (:event-id receipt)})))
    (let [signers (into [(:provider (:signatures receipt))]
                        (:witnesses (:signatures receipt)))]
      (doseq [signer signers]
        (when-not (true? (signature-valid? (signing-message receipt) signer))
          (throw (ex-info "service evidence signature did not verify"
                          {:event-id (:event-id receipt)
                           :signer (:did signer)})))))
    (when-not (true? (policy-valid? receipt))
      (throw (ex-info "service evidence policy is not active or recognized"
                      {:policy-version (:policy-version receipt)})))
    (when-not (true? (evidence-valid? receipt))
      (throw (ex-info "service evidence reference did not verify"
                      {:event-id (:event-id receipt)})))
    receipt))

(defn empty-ledger
  "Create an in-memory replay guard. This is not a durable or economic ledger."
  []
  {:events {} :nonces {}})

(defn admit-receipt
  "Verify and record one receipt in an in-memory, replay-safe evidence set.

  Replaying the same event body is idempotent. Reusing an event ID for changed
  content or reusing an order-scoped nonce for a different event is rejected.
  The result always has an empty :economic-actions vector."
  [ledger receipt verifiers]
  (verify-receipt receipt verifiers)
  (let [event-id (:event-id receipt)
        nonce-key [(:order-id receipt) (:nonce receipt)]
        body (canonical-body receipt)]
    (if-let [prior (get-in ledger [:events event-id])]
      (if (= prior body)
        {:ledger ledger :status :duplicate :event-id event-id
         :economic-actions []}
        (throw (ex-info "service evidence event-id collision"
                        {:event-id event-id})))
      (if-let [prior-id (get-in ledger [:nonces nonce-key])]
        (throw (ex-info "service evidence nonce already used"
                        {:order-id (:order-id receipt)
                         :nonce (:nonce receipt)
                         :prior-event-id prior-id}))
        {:ledger (-> ledger
                     (assoc-in [:events event-id] body)
                     (assoc-in [:nonces nonce-key] event-id))
         :status :accepted
         :event-id event-id
         :economic-actions []}))))
